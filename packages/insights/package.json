{
  "name": "@glot/insights",
  "version": "0.4.0",
  "description": "Cookieless locale demand + conversion beacon for glot Insights (< 2 kB).",
  "license": "MIT",
  "homepage": "https://github.com/MattJeff/glot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattJeff/glot.git",
    "directory": "packages/insights"
  },
  "bugs": "https://github.com/MattJeff/glot/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "default": "./dist/layout.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.ts src/server.ts src/layout.ts --format=esm --minify --target=es2020 --outdir=dist && esbuild src/index.ts --bundle --format=iife --minify --target=es2020 --outfile=dist/insights.global.js && tsc",
    "test": "node --test 'test/*.test.ts'",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25",
    "esbuild": "^0.25",
    "typescript": "^5.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
