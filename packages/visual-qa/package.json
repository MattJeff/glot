{
  "name": "@glot/visual-qa",
  "version": "0.4.1",
  "description": "Visual QA for localized UIs: detects overflowing, truncated, untranslated and tofu text per locale with Playwright.",
  "license": "MIT",
  "homepage": "https://github.com/MattJeff/glot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MattJeff/glot.git",
    "directory": "packages/visual-qa"
  },
  "bugs": "https://github.com/MattJeff/glot/issues",
  "type": "module",
  "bin": {
    "glot-visual-qa": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/cli.js",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "qa": "node src/cli.ts"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^25",
    "esbuild": "^0.25",
    "typescript": "^5.9"
  },
  "packageManager": "pnpm@10.18.3",
  "keywords": [
    "i18n",
    "l10n",
    "visual-qa",
    "playwright",
    "glot"
  ],
  "publishConfig": {
    "access": "public"
  }
}
