# glot production settings. Copy to deploy/.env ON THE SERVER (never commit it):
#   cp .env.example .env && chmod 600 .env
# Generate secrets with: openssl rand -hex 32

# Apex domain. Serves: <domain> (landing + docs), app.<domain> (dashboard), api.<domain> (API, /mcp).
GLOT_DOMAIN=example.com
# Let's Encrypt account e-mail (expiry warnings).
ACME_EMAIL=you@example.com

# Encrypts stored LLM keys. 32 random bytes, hex. NEVER change it once set (stored keys become unreadable).
GLOT_SECRET_KEY=replace-with-openssl-rand-hex-32
# Postgres password (hex keeps it URL-safe inside DATABASE_URL).
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

# Extra browser origins allowed to call /mcp, comma-separated (e.g. http://localhost:6274 for MCP Inspector).
# app.<domain> is always allowed. Server-to-server MCP clients send no Origin and are not affected.
GLOT_MCP_ALLOWED_ORIGINS=

# Transactional email (verification, password reset, notices) via the Resend HTTP API, optional:
# leave RESEND_API_KEY empty to disable email (no verification banner, no reset by email).
# Send from a subdomain verified in Resend (SPF/DKIM/MX on mail.<domain>) to keep the apex reputation clean.
RESEND_API_KEY=
# Default: glot <noreply@mail.${GLOT_DOMAIN}>
#RESEND_FROM=glot <noreply@mail.example.com>
#RESEND_REPLY_TO=support@example.com
#GLOT_EMAIL_RATE_PER_HOUR=10

# Billing (Stripe), optional: leave STRIPE_SECRET_KEY empty to disable billing and all cloud quotas (self-hosting).
# Use a RESTRICTED key (rk_live_...) with the runtime permissions listed in docs/billing.md, never the full sk_ key.
# deploy/stripe-setup.sh creates products/prices/meter/portal/webhook and prints these values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION=
# Usage-based billing of server translations on glot's LLM key (Billing Meter event name); empty = no overage billing.
STRIPE_METER_EVENT=
# 1 = Stripe Tax on Checkout (set up Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=0
#GLOT_BILLING_GRACE_DAYS=7
# Per-plan monthly limits override (JSON, null = unlimited), e.g. {"free":{"projects":1,"seats":1,"cdn_requests":50000,
# "insights_events":10000,"mcp_calls":500,"ondemand_jobs":0,"llm_strings":500}}
#GLOT_PLAN_LIMITS=

# Optional rate limits (per minute).
#GLOT_MCP_RATE_PER_MIN=120
#GLOT_INSIGHTS_RATE_PER_MIN=1200
#GLOT_FEEDBACK_RATE_PER_MIN=30
#RUST_LOG=glot_server=info,tower_http=info

# Backups (deploy/backup.sh, daily cron installed by deploy.sh).
BACKUP_DIR=/home/glot/backups
BACKUP_KEEP_DAYS=14
# Optional off-site copy with rclone, e.g. a Hetzner Storage Box (sftp) or any S3 bucket:
#   remote configured in /home/glot/.config/rclone/rclone.conf, then e.g. RCLONE_REMOTE=storagebox:glot
RCLONE_REMOTE=

# Local test only (GLOT_DOMAIN=localhost): non-default ports. Leave empty in production.
#GLOT_HTTP_PORT=8088
#GLOT_HTTPS_PORT=8443
#GLOT_PORT_SUFFIX=:8443
