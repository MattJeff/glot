# Hetzner Storage Box (BX11) as off-site destination, SFTP on port 23.
# Append to ~/glot/deploy/.env (chmod 600). Replace u123456 with your Storage Box user.
#   ssh-keygen -t ed25519 -N '' -f ~/.ssh/storagebox            # on the server
#   cat ~/.ssh/storagebox.pub | ssh -p 23 u123456@u123456.your-storagebox.de install-ssh-key
#   ssh -p 23 -i ~/.ssh/storagebox u123456@u123456.your-storagebox.de mkdir glot   # (asks the box password once above)
RCLONE_CONFIG_STORAGEBOX_TYPE=sftp
RCLONE_CONFIG_STORAGEBOX_HOST=u123456.your-storagebox.de
RCLONE_CONFIG_STORAGEBOX_USER=u123456
RCLONE_CONFIG_STORAGEBOX_PORT=23
RCLONE_CONFIG_STORAGEBOX_KEY_FILE=/home/glot/.ssh/storagebox
RCLONE_CONFIG_STORAGEBOX_SHELL_TYPE=unix
RCLONE_CONFIG_STORAGEBOX_MD5SUM_COMMAND="md5 -r"
RCLONE_CONFIG_STORAGEBOX_SHA1SUM_COMMAND="sha1 -r"
RCLONE_REMOTE=storagebox:glot
