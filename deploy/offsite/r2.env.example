# Cloudflare R2 as off-site destination. Append to ~/glot/deploy/.env (chmod 600).
# rclone reads remotes from RCLONE_CONFIG_<NAME>_* env vars: no rclone.conf needed.
# Credentials: dash.cloudflare.com > R2 > Manage API tokens > Create Account API token,
#   permission "Object Read & Write", "Apply to specific buckets only" = glot-backups.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=CHANGE_ME
RCLONE_CONFIG_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
RCLONE_REMOTE=r2:glot-backups
